        { key: "text", value: @moonvalve.StringValue("\uFEFFvalue"), },
      ]),
    },
  ]
  let bytes = b"\x01\x64\x75\x70\x00\xe4\xb8\xad\xe6\x96\x87\xf0\x9f\x98\x80\x32\x31\x00\x02\x64\x75\x70\x00\x15\x00\x00\x80\x03\x66\x6c\x6f\x61\x74\x00\x00\x00\x28\x40\x04\x70\x6f\x69\x6e\x74\x65\x72\x00\xea\xff\xff\xff\x06\x63\x6f\x6c\x6f\x72\x00\x16\x02\x03\x04\x07\x75\x36\x34\x00\xea\xff\xff\xff\xff\xff\xff\xff\x0a\x69\x36\x34\x00\x15\x00\x00\x00\x00\x00\x00\x80\x00\x6f\x62\x6a\x65\x63\x74\x00\x00\x65\x6d\x70\x74\x79\x00\x08\x01\x74\x65\x78\x74\x00\xef\xbb\xbf\x76\x61\x6c\x75\x65\x00\x08\x08"
  assert_eq(@moonvalve.encode_binary(expected), bytes)
  assert_eq(@moonvalve.decode_binary(bytes), expected)
}

